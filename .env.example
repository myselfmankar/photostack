# Copy to .env. Everything is optional.

# Default: SQLite file in the project folder.
# DATABASE_URL="postgresql://demo:demo@localhost:5432/db"   # needs: uv sync --extra postgres

# Optional AI tagging (needs: uv sync --extra ai). Leave unset to run without AI.
# GEMINI_API_KEY=""

# Only used by docker-compose's Postgres service.
POSTGRES_DB="db"
POSTGRES_USER="demo"
POSTGRES_PASSWORD="demo"
